{{/newChapter}}
		<navPoint id="np_{{order}}" playOrder="{{order}}">
			<navLabel><text>{{title}}</text></navLabel>
			<content src="OEBPS/{{serialName}}.html"/>
		</navPoint>
{{/episodes}}
	</navPoint>
{{/chapters}}
{{#episodes}}
	<navPoint id="np_{{order}}" playOrder="{{order}}">
		<navLabel><text>{{title}}</text></navLabel>
		<content src="OEBPS/{{serialName}}.html"/>
	</navPoint>
{{/episodes}}
	<navPoint id="np_99999" playOrder="99999">
		<navLabel><text>使用条件</text></navLabel>
		<content src="OEBPS/terms.html"/>
	</navPoint>
</navMap>
</ncx>
